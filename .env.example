# Copia in .env.local e riempi. .env.local non esce mai da questo Mac.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SMARTLEAD_API_KEY=

# Il cervello di Clara (scripts/cervello.py). Dre, 7/9: OpenAI, non Anthropic.
# Con la chiave presente il fornitore e' openai; senza, resta Claude Code sul
# Mac come ponte. MODELLO_OPENAI si decide col confronto sulle risposte vere.
FORNITORE=openai
OPENAI_API_KEY=
MODELLO_OPENAI=gpt-5-mini

# Calendario: indirizzo segreto iCal (Google Calendar > impostazioni > Indirizzo segreto in formato iCal)
CALENDARIO_ICS=
# Granola: chiave API grn_... (app Granola > Settings > API keys, piano Business)
GRANOLA_API_KEY=

# Telegram: notifica sul telefono di Dre (bot da @BotFather; chat id con scripts/avvisa.py --chi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
